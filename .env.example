# Public, browser-safe Supabase configuration.
#
# Only the *publishable* key belongs here — it is shipped to the browser by
# design. The service-role key (SUPABASE_SERVICE_ROLE_KEY) is a secret: it is
# never committed, never exposed as a VITE_ variable, and only ever read by
# the server runtime.
#
# Copy to `.env.local` for local development, or set the matching repository
# variables (VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY) so the
# GitHub Pages build can inject them.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
